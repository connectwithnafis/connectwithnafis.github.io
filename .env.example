# Copy to `.env` and fill in to enable optional features. Leave empty to use defaults.

# URL of your deployed chat Worker (see /server/README.md) — enables real-LLM chat.
VITE_CHAT_API_URL=

# Formspree endpoint (https://formspree.io/f/xxxx) — enables the working contact form.
VITE_FORMSPREE_ENDPOINT=
